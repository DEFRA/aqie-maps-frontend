AQIE_BACK_END_URL=http://host.docker.internal:3001
AQIE_FORECAST_API_URL=http://host.docker.internal:3002

# Optional — browser-reachable base URL of aqie-dataselector-frontend, used to link to
# station summaries from the map's station panel. Must resolve from the browser (e.g.
# http://localhost:3010), not a Docker-internal hostname. Leave unset to hide the link.
DATASELECTOR_FRONT_END_URL=http://localhost:3010

# Required for OS Names API (UK geocoding) — obtain from the OS Data Hub
OS_NAMES_API_KEY=

# Must be at least 32 characters; required when NODE_ENV=production (set by compose.yml)
# Use a randomly generated secret in production — never commit a real value here
SESSION_COOKIE_PASSWORD=local-dev-only-password-not-a-real-secret
